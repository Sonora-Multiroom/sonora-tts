<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent lives in the multiroom-ai repository and is resolved from the local Maven
         repository (~/.m2), never from a sibling directory. An empty <relativePath/> is what
         tells Maven to skip the ../multiroom-extension-starter lookup; without it the build
         fails before it starts. Install it with, in multiroom-ai:
             mvn -pl multiroom-api,multiroom-extension-starter -am install -->
    <parent>
        <groupId>ai.multiroom</groupId>
        <artifactId>multiroom-extension-starter</artifactId>
        <version>0.1.18</version>
        <relativePath/>
    </parent>

    <artifactId>multiroom-tts</artifactId>
    <version>0.1.1</version>
    <packaging>jar</packaging>
    <name>multiroom-tts</name>
    <description>Text-to-Speech announcement extension for the multiroom audio system</description>

    <properties>
        <extension.name>TTS Extension</extension.name>
        <!-- NOT derived from the artifact id. `tts` is the single string three mechanisms share:
             ExtensionScanner validates it against ^[a-z0-9-]+$, ExtensionStatusResolver reads
             `multiroom.<id>.enabled` from it, and TtsAutoConfiguration's @ConditionalOnProperty
             names that property literally. `multiroom-tts` here would split the on/off switch in
             two, silently. -->
        <extension.id>tts</extension.id>

        <!-- The starter defaults this to ${project.version}, which now means *this extension's*
             version. Pin the API version explicitly: it is what the JAR manifest advertises as
             Require-API-Version, and what the host's compatibility check reads. -->
        <multiroom.require_api_version>0.1.18</multiroom.require_api_version>

        <!-- The starter's `remote` profile (active by default) scp's the built JAR to
             multiroom.lan:/home/tiger/extensions. Child JARs opt in. -->
        <skip.wagon.upload>false</skip.wagon.upload>

        <!-- The starter's `local` profile copies to ${project.basedir}/../extensions, which is a
             sibling of the module inside the monorepo. Outside it, point at the host checkout's
             extensions directory. Override on the command line for a different checkout:
             mvn deploy -Plocal -Dmultiroom.local-extensions-dir=... -->
        <multiroom.local-extensions-dir>D:/projects-multiroom/multiroom-ai/extensions</multiroom.local-extensions-dir>
    </properties>

    <dependencies>
        <!-- Everything below is `provided`: the host supplies all of it at runtime under the
             shared classloader, and bundling any of it risks colliding with another
             independently built extension. multiroom-api itself comes from the parent POM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>
        <!-- Compile-time only, for @Operation/@ApiResponse documentation annotations (T026,
             T059): springdoc reads these reflectively at runtime, and multiroom-rest is what
             actually bundles springdoc plus this artifact onto the shared classpath. Pinned to
             the exact version multiroom-rest.jar ships (io.swagger.core.v3:swagger-annotations-jakarta
             2.2.47, springdoc 2.8.17) so this module never supplies its own copy at runtime -
             `provided` scope guarantees that, this pin just keeps compilation honest about which
             API surface is actually available. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.47</version>
            <scope>provided</scope>
        </dependency>

        <!-- WAV parsing uses the JDK's javax.sound.sampled (java.desktop), so multiroom-decoder
             is deliberately absent: multiroom-api is the only artifact of the host repository on
             this compile path. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.9.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The constitution's 80% line-coverage floor (III) as a build gate: `mvn verify`
                 fails below it. Pinned explicitly because the starter does not manage it; 0.8.11
                 is the version multiroom-ai's root POM uses. A build plugin, so nothing is shaded
                 into the JAR. The inherited surefire configuration sets no argLine, so
                 prepare-agent's property is picked up without an @{argLine} merge. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Overrides the starter's copy target, which assumes a sibling extensions directory. -->
        <profile>
            <id>local</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-to-extensions</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              tofile="${multiroom.local-extensions-dir}/${project.artifactId}.jar"
                                              overwrite="true"/>
                                        <echo message="Copied ${project.build.finalName}.jar to ${multiroom.local-extensions-dir}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
